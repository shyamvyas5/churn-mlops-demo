# Application Settings
APP_NAME=churn-scoring-service
APP_ENV=development
LOG_LEVEL=INFO

# MLflow Settings (Local host port-forward vs In-cluster service)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=churn-batch-scoring
MLFLOW_MODEL_NAME=churn_classifier

# Garage S3 Settings
S3_ENDPOINT_URL=http://localhost:3900
S3_BUCKET_NAME=churn-mlops
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage

# Direct S3/MLflow compatibility flags
MLFLOW_S3_ENDPOINT_URL="http://localhost:3900"
MLFLOW_S3_IGNORE_TLS="true"
AWS_S3_FORCE_PATH_STYLE="true"

# Pipeline Configurations
BATCH_SIZE=1000
RANDOM_STATE=42

# API Server
API_HOST=0.0.0.0
API_PORT=8000
